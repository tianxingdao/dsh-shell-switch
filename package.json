{
  "name": "dsh-shell-switch",
  "version": "0.1.0",
  "private": true,
  "description": "Choose which local shell runs DSH bash commands (e.g. Niubash, Git Bash, MSYS2) and add a Shell selector page to Settings.",
  "license": "MIT",
  "author": "tianxingdao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianxingdao/dsh-shell-switch.git"
  },
  "homepage": "https://github.com/tianxingdao/dsh-shell-switch#readme",
  "bugs": {
    "url": "https://github.com/tianxingdao/dsh-shell-switch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "shell",
    "bash",
    "niubash",
    "git-bash",
    "msys2"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
